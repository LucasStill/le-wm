\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The TurboSens evaluation framework. (i)} A turbofan engine is decomposed into subsystems whose health degrades over time, modulated by operating context, fouling, and maintenance actions $a$ that restore selected components of the health state. \textbf  {(ii)} Subsystem health and fouling channels assemble into a global state $\omega $ that OpenDeckSMR (ODSMR) maps to sensor observations across $C$ flight phase contexts. \textbf  {(iii)} A world model learns a representation from these observations in a self supervised manner; at test time, the frozen representations are probed against the true subsystem health, framing representation evaluation as an inverse problem. \textbf  {(iv)} Companion downstream tasks include forecasting possible futures conditioned on candidate maintenance policies.\relax }}{4}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:problem_formulation}{{1}{4}{\textbf {The TurboSens evaluation framework. (i)} A turbofan engine is decomposed into subsystems whose health degrades over time, modulated by operating context, fouling, and maintenance actions $a$ that restore selected components of the health state. \textbf {(ii)} Subsystem health and fouling channels assemble into a global state $\omega $ that OpenDeckSMR (ODSMR) maps to sensor observations across $C$ flight phase contexts. \textbf {(iii)} A world model learns a representation from these observations in a self supervised manner; at test time, the frozen representations are probed against the true subsystem health, framing representation evaluation as an inverse problem. \textbf {(iv)} Companion downstream tasks include forecasting possible futures conditioned on candidate maintenance policies.\relax }{figure.caption.7}{}}
